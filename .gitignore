# BUSSter .gitignore

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.cproject
.settings/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Arduino/PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json

# KiCad
*.bak
*-bak
*.kicad_pcb-bak
*-save.pro
*-save.kicad_pcb
*~
*.bck
*.kicad_pro-bak
fp-info-cache
# But keep the main project files
!*.kicad_pro
!*.kicad_sch
!*.kicad_pcb

# Build artifacts
*.o
*.elf
*.hex
*.bin
*.map

# Test results
test_results/
coverage/

# Simulation results
simulation_output/
*.sim

# Manufacturing files (keep in repo but ignore temp)
gerber/tmp/
gerber/*-job.gbrjob.tmp

# Documentation builds
docs/_build/
docs/.doctrees/

# Temporary files
tmp/
temp/
*.tmp
*.log

# Secrets (just in case)
secrets.txt
credentials.json
*.key
*.pem
